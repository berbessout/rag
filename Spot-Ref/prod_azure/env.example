# =============================================================================
# SPOT-REF PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# -----------------------------------------------------------------------------
# AZURE OPENAI CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_FINAL_MODEL_DEPLOYMENT=gpt-4.1-mini
AZURE_AGENT_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2023-05-15

# -----------------------------------------------------------------------------
# QDRANT VECTOR DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=spot-ref-docs

# -----------------------------------------------------------------------------
# SHAREPOINT INTEGRATION (OPTIONAL - For document ingestion)
# -----------------------------------------------------------------------------
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
SHAREPOINT_USERNAME=your-username@your-tenant.onmicrosoft.com
SHAREPOINT_PASSWORD=your-password
SHAREPOINT_LIBRARY_NAME=Shared Documents

# -----------------------------------------------------------------------------
# LANGFUSE OBSERVABILITY (OPTIONAL - For monitoring)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# INGESTION CONFIGURATION
# -----------------------------------------------------------------------------
INGESTION_MODE=5
BATCH_SIZE=64
DATA_DIR=Customer_txt

# -----------------------------------------------------------------------------
# WORKER POOL CONFIGURATION
# -----------------------------------------------------------------------------
DOWNLOAD_WORKERS=10
CONVERSION_WORKERS=10
TRANSLATION_WORKERS=10
SPLITTING_WORKERS=10
EMBEDDING_WORKERS=10
MAX_MEMORY_GB=4.0

# -----------------------------------------------------------------------------
# RETRY AND RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=60.0
API_RATE_LIMIT_OPENAI=10
API_RATE_LIMIT_SP=50

# -----------------------------------------------------------------------------
# PROGRESS TRACKING
# -----------------------------------------------------------------------------
ENABLE_PROGRESS_TRACKING=true

# -----------------------------------------------------------------------------
# AZURE CONTAINER APPS DEPLOYMENT (PRODUCTION)
# -----------------------------------------------------------------------------
# Set these when deploying to Azure Container Apps
# QDRANT_HOST=your-qdrant-container-app.azurecontainerapps.io
# LANGFUSE_HOST=your-langfuse-container-app.azurecontainerapps.io

# -----------------------------------------------------------------------------
# OPTIONAL: AUTHENTICATION
# -----------------------------------------------------------------------------
# CHAINLIT_AUTH_SECRET=your-chainlit-auth-secret 